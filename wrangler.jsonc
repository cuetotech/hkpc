{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hkpc",
  "compatibility_date": "2026-10-07",
  "main": "src/worker.js",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "TRANSLATION_LIMITER",
      "namespace_id": "18062026",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/*.html",
      "/main/*",
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "vahopechurch.org",
      "custom_domain": true
    }
  ],
  "previews": {
    "ai": {
      "binding": "AI"
    },
    "ratelimits": [
      {
        "name": "TRANSLATION_LIMITER",
        "namespace_id": "18062027",
        "simple": {
          "limit": 30,
          "period": 60
        }
      }
    ]
  }
}
